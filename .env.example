# ============================================================
# AL-BAYAAN — Variables d'environnement
# ============================================================

# Base de données PostgreSQL (Prisma)
# Format : postgresql://USER:PASSWORD@HOST:PORT/DB_NAME
# Exemple local : postgresql://postgres:postgres@localhost:5432/al_bayan
# Exemple Supabase : postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
# Supabase Session pooler (recommandé pour les migrations) :
# postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres
# ⚠️ Si le mot de passe contient @, #, /, ?…, utilisez la chaîne déjà encodée fournie par Supabase.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/al_bayan"

# Supabase (optionnel — activer uniquement quand la base est prête)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# ⚠️ CLÉ SECRÈTE service_role (jamais exposée côté client !)
# À obtenir dans : Supabase Dashboard → Settings → API → service_role
# Utilisée par l'API /api/auth/register et /api/auth/setup-demo
# pour créer des utilisateurs, bypass RLS, confirmer les emails, etc.
SUPABASE_SERVICE_ROLE_KEY=""

# JWT / Session (si génération de tokens serveur)
# JWT_SECRET="votre-secret-jwt"